{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GemAgents explicit benchmark mapping v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": 2},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_sha256", "source_url", "mapping_evidence"],
      "properties": {
        "model_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_url": {"type": "string", "minLength": 1},
        "mapping_evidence": {"type": "string", "minLength": 1}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assembly_accession",
        "strain_id",
        "sequence_sha256",
        "mapping_evidence",
        "kingdom",
        "taxonomy_evidence",
        "selected_reference_model_id",
        "biomass_source_model_id",
        "candidate_reference_model_ids",
        "references"
      ],
      "properties": {
        "assembly_accession": {"type": "string", "pattern": "^GC[AF]_[0-9]{9}\\.[0-9]+$"},
        "strain_id": {"type": "string", "minLength": 1},
        "sequence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mapping_evidence": {"type": "string", "minLength": 1},
        "kingdom": {"enum": ["bacteria", "archaea", "eukaryota"]},
        "taxonomy_evidence": {"type": "string", "minLength": 1},
        "selected_reference_model_id": {"type": "string", "minLength": 1},
        "biomass_source_model_id": {"type": "string", "minLength": 1},
        "candidate_reference_model_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/reference"}
        }
      }
    }
  }
}
